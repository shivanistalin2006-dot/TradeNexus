# Google Gemini API Key (Optional - Rule-based qualification fallback is active if empty)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Exporter Commercial Profile
EXPORTER_COMPANY="Vedic Sound & Crafts India Pvt Ltd"
EXPORTER_NAME="Rajesh Sharma"
EXPORTER_EMAIL="export@vedicsoundcrafts.com"
EXPORTER_PHONE="+91 98112 34567"
EXPORTER_WEBSITE="https://www.vedicsoundcrafts.com"
DEFAULT_PRODUCT="Handcrafted Tibetan Singing Bowls, Brass Meditation Bells & Healing Chimes"
EXPORT_PORT="ICD Tughlakabad / Delhi Air Cargo, India"

# Email Outreach Settings
# Set to true to simulate outreach campaigns without emailing real inboxes
EMAIL_DEMO_MODE=true
BATCH_SEND_DELAY=1.5

# Gmail OAuth 2.0 (Optional - required only for live Gmail inbox dispatch)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=
